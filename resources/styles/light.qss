
QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    background-color: #ffffff;
    color: #333333;
}

QMainWindow {
    background-color: #ffffff;
}

QSplitter::handle {
    background-color: #dee2e6;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #0078d4;
}

QMenuBar {
    background-color: #f1f3f4;
    color: #333333;
    border-bottom: 1px solid #dee2e6;
    font-size: 12px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #e2e6ea;
    color: #333333;
    border-radius: 4px;
}

QMenu {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    padding: 3px 0px;
    font-size: 12px;
}

QMenu::item {
    padding: 4px 20px 4px 20px;
    color: #333333;
}

QMenu::item:selected {
    background-color: #e8f0fe;
    color: #0078d4;
}

QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #dee2e6;
    selection-background-color: #e8f0fe;
    selection-color: #0078d4;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #dee2e6;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #0078d4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #dee2e6;
    min-width: 20px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #0078d4;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0px;
}

QTabWidget::pane {
    border: none;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #f8f9fa;
    color: #333333;
    padding: 6px 14px;
    border: none;
    border-right: 1px solid #dee2e6;
    border-bottom: 1px solid #dee2e6;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0078d4;
    border-bottom: 2px solid #0078d4;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #e2e6ea;
}

QStatusBar {
    background-color: #f1f3f4;
    color: #333333;
    border-top: 1px solid #dee2e6;
    font-size: 10px;
    min-height: 18px;
    max-height: 20px;
}

QStatusBar::item {
    border: none;
    margin: 0;
    padding: 0;
}

QStatusBar QLabel {
    background-color: transparent;
    color: #333333;
    padding: 0 4px;
    font-size: 10px;
}

QStatusBar QPushButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 0px 5px 1px 5px;
    font-size: 10px;
    min-height: 0px;
    max-height: 16px;
    height: 16px;
    border-radius: 2px;
    margin: 0px;
}

QStatusBar QPushButton:hover {
    background-color: rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(0, 0, 0, 0.15);
}

QStatusBar QPushButton:pressed {
    background-color: rgba(0, 0, 0, 0.15);
}

QLineEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #dee2e6;
    padding: 4px 8px;
    border-radius: 3px;
}

QLineEdit:focus {
    border: 1px solid #0078d4;
}

QDialog, QMessageBox {
    background-color: #ffffff;
    color: #333333;
}

QMessageBox QLabel {
    color: #333333;
    font-size: 13px;
}

QPushButton {
    background-color: #f8f9fa;
    color: #333333;
    border: 1px solid #dee2e6;
    padding: 5px 12px;
    border-radius: 3px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #e2e6ea;
    border-color: #0078d4;
    color: #333333;
}

QPushButton:pressed {
    background-color: #dae0e5;
}

/* --- Activity Bar & Side Bar --- */
QWidget#activityBar {
    background-color: #f1f3f4;
    border-right: 1px solid #dee2e6;
}

QWidget#activityBar QPushButton#activityBtn {
    background: transparent;
    border: none;
    font-size: 14px;
    width: 30px;
    height: 30px;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0px;
    margin: 0px;
    border-radius: 4px;
    color: #333333;
}

QWidget#activityBar QPushButton#activityBtn:hover {
    color: #333333;
    background-color: #e2e6ea;
}

QWidget#activityBar QPushButton#activityBtn:checked {
    color: #0078d4;
    background-color: #f8f9fa;
    border-left: 2px solid #0078d4;
    border-radius: 0px;
}

QWidget#sideBar {
    background-color: #f8f9fa;
    border-right: 1px solid #dee2e6;
}

QWidget#sideBar QPushButton {
    min-width: 0px;
    min-height: 0px;
}

QWidget#sideBar QPushButton#sidebarHeaderBtn {
    border: none;
    background: transparent;
    border-radius: 3px;
    width: 20px;
    height: 20px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0px;
    font-size: 11px;
    color: #333333;
}

QWidget#sideBar QPushButton#sidebarHeaderBtn:hover {
    background-color: #e2e6ea;
    color: #333333;
}

QWidget#sideBar QPushButton#sidebarPillBtn {
    border: 1px solid #dee2e6;
    background-color: #f8f9fa;
    border-radius: 2px;
    min-width: 40px;
    max-width: 46px;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    padding: 0px 4px;
    font-size: 9px;
    font-weight: 600;
    color: #333333;
}

QWidget#sideBar QPushButton#sidebarPillBtn:hover {
    background-color: #e2e6ea;
    border-color: #0078d4;
    color: #333333;
}

QWidget#sideBar QPushButton#sidebarActionBtn {
    border: 1px solid #dee2e6;
    background-color: #f8f9fa;
    border-radius: 3px;
    min-width: 48px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 1px 6px;
    font-size: 10px;
    color: #333333;
}

QWidget#sideBar QPushButton#sidebarActionBtn:hover {
    background-color: #e2e6ea;
    border-color: #0078d4;
    color: #333333;
}

QTreeView, QTreeWidget {
    background-color: #f8f9fa;
    color: #333333;
    border: none;
    font-size: 12px;
    outline: none;
}

QTreeView::item, QTreeWidget::item {
    padding: 3px 6px;
    border-radius: 3px;
}

QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: #e2e6ea;
}

QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: #e8f0fe;
    color: #0078d4;
}

/* --- Attributes Table --- */
QTableView, QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8f9fa;
    gridline-color: #dee2e6;
    border: 1px solid #dee2e6;
    color: #333333;
    selection-background-color: #e8f0fe;
    selection-color: #0078d4;
}

QHeaderView::section {
    background-color: #f1f3f4;
    color: #333333;
    padding: 4px 8px;
    border: 1px solid #dee2e6;
    font-weight: bold;
    font-size: 11px;
}

QComboBox, QDoubleSpinBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    color: #333333;
    padding: 4px 8px;
    border-radius: 3px;
}

QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #0078d4;
}

QProgressBar {
    border: 1px solid #dee2e6;
    border-radius: 3px;
    background-color: #f8f9fa;
    text-align: center;
    color: #333333;
}

QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 2px;
}
