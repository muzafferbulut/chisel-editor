QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    background-color: #ffffff;
    color: #24292e;
}

QMainWindow {
    background-color: #ffffff;
}

QSplitter::handle {
    background-color: #e1e4e8;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #0366d6;
}

QMenuBar {
    background-color: #f6f8fa;
    color: #24292e;
    border-bottom: 1px solid #e1e4e8;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background-color: #e1e4e8;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    padding: 5px 0px;
}

QMenu::item {
    padding: 6px 24px 6px 24px;
}

QMenu::item:selected {
    background-color: #0366d6;
    color: #ffffff;
}

QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #24292e;
    border: none;
    selection-background-color: #c8e1ff;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #d1d5da;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #959da5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #d1d5da;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #959da5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0px;
}

QDialog {
    background-color: #f6f8fa;
}

QMessageBox {
    background-color: #ffffff;
}

QListWidget, QListView {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    border-radius: 4px;
    outline: none;
}

QListWidget::item {
    padding: 8px;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #f3f4f6;
}

QListWidget::item:selected {
    background-color: #e8f2fe;
    color: #0366d6;
    font-weight: 600;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    color: #24292e;
    padding: 6px;
    border-radius: 4px;
}

QLineEdit:focus {
    border: 1px solid #0366d6;
}

QPushButton {
    background-color: #f3f4f6;
    color: #24292e;
    border: 1px solid #e1e4e8;
    padding: 6px 14px;
    border-radius: 4px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #e1e4e8;
}

QPushButton#btn_load {
    background-color: #2ea44f; /* GitHub Yeşil */
    color: #ffffff;
    border: none;
}

QPushButton#btn_load:hover { background-color: #2c974b; }

QPushButton#btn_cancel {
    background-color: transparent;
    border: none;
}

QPushButton#btn_cancel:hover { background-color: #f3f4f6; }

QToolTip {
    background-color: #24292e;
    color: #ffffff;
    border: none;
    padding: 4px;
}

QStatusBar {
    background-color: #0366d6;
    color: #ffffff;
}

QStatusBar::item {
    border: none;
}