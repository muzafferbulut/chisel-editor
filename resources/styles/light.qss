QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    background-color: #ffffff;
    color: #24292e;
}

QMainWindow {
    background-color: #ffffff;
}

QSplitter::handle {
    background-color: #e1e4e8;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #0366d6;
}

QMenuBar {
    background-color: #f6f8fa;
    color: #24292e;
    border-bottom: 1px solid #e1e4e8;
    font-size: 12px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #e1e4e8;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    padding: 3px 0px;
    font-size: 12px;
}

QMenu::item {
    padding: 4px 20px 4px 20px;
}

QMenu::item:selected {
    background-color: #0366d6;
    color: #ffffff;
}

QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #24292e;
    border: none;
    selection-background-color: #add6ff;
    selection-color: #24292e;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #d1d5da;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #959da5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #d1d5da;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #959da5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0px;
}

QListWidget, QListView {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    border-radius: 4px;
    outline: none;
}

QListWidget::item {
    padding: 5px 8px;
    border-radius: 3px;
    margin-bottom: 1px;
}

QListWidget::item:hover {
    background-color: #f3f4f6;
}

QListWidget::item:selected {
    background-color: #e8f2fe;
    color: #0366d6;
    font-weight: 600;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    color: #24292e;
    padding: 6px;
    border-radius: 4px;
}

QLineEdit:focus {
    border: 1px solid #0366d6;
}

QToolTip {
    background-color: #24292e;
    color: #ffffff;
    border: none;
    padding: 4px;
}

QStatusBar {
    background-color: #f6f8fa;
    color: #586069;
    font-size: 12px;
    border-top: 1px solid #e1e4e8;
}

QStatusBar::item {
    border: 0px solid transparent;
    border-style: none;
    outline: none;
}

QStatusBar {
    background: transparent;
    color: #24292e;
    padding: 0px 8px;
    font-weight: 500;
}

QTabWidget::pane {
    border: none;
    border-top: 1px solid #e1e4e8;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #f3f4f6;
    color: #586069;
    padding: 2px 6px; 
    border: none;
    border-right: 1px solid #e1e4e8;
    min-height: 22px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #24292e;
    border-top: 2px solid #0366d6;
}

QTabBar::tab:hover:!selected {
    background-color: #e8eaed;
    color: #24292e;
}

QDialog, QMessageBox {
    background-color: #ffffff;
    color: #24292e;
}
QMessageBox QLabel {
    color: #24292e;
    font-size: 13px;
}
QPushButton {
    background-color: #0366d6;
    color: #ffffff;
    border: none;
    padding: 6px 16px;
    border-radius: 3px;
    min-width: 60px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #005cc5;
}
QPushButton:pressed {
    background-color: #034994;
}


/* --- Activity Bar & Side Bar --- */
QWidget#activityBar {
    background-color: #2c2c2c;
    border-right: 1px solid #d1d5da;
}

QWidget#activityBar QPushButton#activityBtn {
    background: transparent;
    border: none;
    font-size: 14px;
    width: 30px;
    height: 30px;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0px;
    margin: 0px;
    border-radius: 4px;
    color: #999999;
}

QWidget#activityBar QPushButton#activityBtn:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.12);
}

QWidget#activityBar QPushButton#activityBtn:checked {
    color: #ffffff;
    background-color: #f6f8fa;
    border-left: 2px solid #0366d6;
    border-radius: 0px;
}

QWidget#sideBar {
    background-color: #f6f8fa;
    border-right: 1px solid #d1d5da;
}

QWidget#sideBar QPushButton {
    min-width: 0px;
    min-height: 0px;
}

QWidget#sideBar QPushButton#sidebarHeaderBtn {
    border: none;
    background: transparent;
    border-radius: 3px;
    width: 20px;
    height: 20px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0px;
    font-size: 11px;
    color: #6a737d;
}

QWidget#sideBar QPushButton#sidebarHeaderBtn:hover {
    background-color: rgba(0, 0, 0, 0.08);
    color: #24292e;
}

QWidget#sideBar QPushButton#sidebarPillBtn {
    border: 1px solid rgba(0, 0, 0, 0.15);
    background-color: rgba(0, 0, 0, 0.03);
    border-radius: 2px;
    min-width: 40px;
    max-width: 46px;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    padding: 0px 4px;
    font-size: 9px;
    font-weight: 600;
    color: #586069;
}

QWidget#sideBar QPushButton#sidebarPillBtn:hover {
    background-color: rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.25);
    color: #24292e;
}

QWidget#sideBar QPushButton#sidebarActionBtn {
    border: 1px solid rgba(0, 0, 0, 0.15);
    background-color: rgba(0, 0, 0, 0.03);
    border-radius: 3px;
    min-width: 48px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 1px 6px;
    font-size: 10px;
    color: #444d56;
}

QWidget#sideBar QPushButton#sidebarActionBtn:hover {
    background-color: rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.25);
    color: #24292e;
}

QTreeView, QTreeWidget {
    background-color: #f6f8fa;
    color: #24292e;
    border: none;
    font-size: 12px;
    outline: none;
}

QTreeView::item, QTreeWidget::item {
    padding: 3px 6px;
    border-radius: 4px;
}

QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: #e1e4e8;
}

QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: #0366d6;
    color: #ffffff;
}

/* --- Spatial Toolbar & View Controls --- */
QWidget#spatialToolbar, QWidget#tabToolbar {
    background-color: #f6f8fa;
    border-bottom: 1px solid #d1d5da;
}

QPushButton#viewModeBtn, QWidget#tabToolbar QPushButton {
    background-color: #ffffff;
    color: #24292e;
    border: 1px solid #d1d5da;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 11px;
}

QPushButton#viewModeBtn:hover, QWidget#tabToolbar QPushButton:hover {
    background-color: #f1f2f4;
}

QPushButton#viewModeBtn:checked, QWidget#tabToolbar QPushButton:checked {
    background-color: #0366d6;
    color: #ffffff;
    border-color: #0366d6;
    font-weight: bold;
}

/* --- QTableView / QTableWidget / Attributes Table --- */
QTableView, QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f6f8fa;
    gridline-color: #e1e4e8;
    border: 1px solid #d1d5da;
    color: #24292e;
    selection-background-color: #0366d6;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #f0f2f5;
    color: #24292e;
    padding: 4px 8px;
    border: 1px solid #d1d5da;
    font-weight: bold;
    font-size: 11px;
}

QComboBox, QDoubleSpinBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #d1d5da;
    color: #24292e;
    padding: 4px 8px;
    border-radius: 3px;
}

QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #0366d6;
}

QGroupBox {
    border: 1px solid #d1d5da;
    border-radius: 4px;
    margin-top: 8px;
    font-weight: bold;
    color: #24292e;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
}