QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    background-color: #1e1e1e;
    color: #cccccc;
}

QMainWindow {
    background-color: #1e1e1e;
}

QSplitter::handle {
    background-color: #333333;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #0366d6;
}

QMenuBar {
    background-color: #181818;
    color: #cccccc;
    border-bottom: 1px solid #333333;
    font-size: 12px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #333333;
    color: #ffffff;
    border-radius: 4px;
}

QMenu {
    background-color: #252526;
    border: 1px solid #333333;
    padding: 3px 0px;
    font-size: 12px;
}

QMenu::item {
    padding: 4px 20px 4px 20px;
}

QMenu::item:selected {
    background-color: #04395e;
    color: #ffffff;
}

QPlainTextEdit, QTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
    selection-background-color: #264f78;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #424242;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #4f4f4f;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #424242;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #4f4f4f;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0px;
}


QListWidget, QListView {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 4px;
    outline: none;
}

QListWidget::item {
    padding: 5px 8px;
    border-radius: 3px;
    margin-bottom: 1px;
}

QListWidget::item:hover {
    background-color: #2a2d2e;
}

QListWidget::item:selected {
    background-color: #37373d;
    color: #ffffff;
}

QLineEdit {
    background-color: #3c3c3c;
    border: 1px solid #3c3c3c;
    color: #cccccc;
    padding: 6px;
    border-radius: 4px;
}

QLineEdit:focus {
    border: 1px solid #007fd4;
}


QToolTip {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #454545;
    padding: 4px;
}

QStatusBar {
    background-color: #181818;
    color: #cccccc;
    font-size: 12px;
    border-top: 1px solid #2b2b2b;
}

QStatusBar::item {
    border: 0px solid transparent;
    border-style: none;
    outline: none;
}

QStatusBar {
    background: transparent;
    color: #cccccc;
    padding: 0px 8px;
    font-weight: 500;
}

QTabWidget::pane {
    border: none;
    border-top: 1px solid #252526;
    background-color: #1e1e1e;
}

QTabBar::tab {
    background-color: #2d2d2d;
    color: #858585;
    padding: 2px 6px;
    border: none;
    border-right: 1px solid #252526;
    min-height: 22px;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #ffffff;
    border-top: 2px solid #007fd4;
}

QTabBar::tab:hover:!selected {
    background-color: #333333;
    color: #cccccc;
}

QDialog, QMessageBox {
    background-color: #252526;
    color: #cccccc;
}
QMessageBox QLabel {
    color: #cccccc;
    font-size: 13px;
}
QPushButton {
    background-color: #0e639c; /* VS Code Mavi Buton */
    color: #ffffff;
    border: none;
    padding: 6px 16px;
    border-radius: 3px;
    min-width: 60px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #1177bb;
}
QPushButton:pressed {
    background-color: #094771;
}


/* --- Activity Bar & Side Bar --- */
QWidget#activityBar {
    background-color: #333333;
    border-right: 1px solid #252526;
}

QPushButton#activityBtn {
    background: transparent;
    border: none;
    font-size: 18px;
    padding: 10px 4px;
    border-radius: 0px;
    color: #858585;
}

QPushButton#activityBtn:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
}

QPushButton#activityBtn:checked {
    color: #ffffff;
    background-color: #252526;
    border-left: 2px solid #007fd4;
}

QWidget#sideBar {
    background-color: #252526;
    border-right: 1px solid #333333;
}

QTreeView, QTreeWidget {
    background-color: #252526;
    color: #cccccc;
    border: none;
    font-size: 12px;
    outline: none;
}

QTreeView::item, QTreeWidget::item {
    padding: 3px 6px;
    border-radius: 4px;
}

QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: #2a2d2e;
}

QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}

/* --- Spatial Toolbar & View Controls --- */
QWidget#spatialToolbar, QWidget#tabToolbar {
    background-color: #252526;
    border-bottom: 1px solid #333333;
}

QPushButton#viewModeBtn, QWidget#tabToolbar QPushButton {
    background-color: #2d2d2d;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 11px;
}

QPushButton#viewModeBtn:hover, QWidget#tabToolbar QPushButton:hover {
    background-color: #383838;
}

QPushButton#viewModeBtn:checked, QWidget#tabToolbar QPushButton:checked {
    background-color: #0e639c;
    color: #ffffff;
    border-color: #007fd4;
    font-weight: bold;
}

/* --- QTableView / QTableWidget / Attributes Table --- */
QTableView, QTableWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    gridline-color: #333333;
    border: 1px solid #333333;
    color: #cccccc;
    selection-background-color: #094771;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #2d2d2d;
    color: #cccccc;
    padding: 4px 8px;
    border: 1px solid #333333;
    font-weight: bold;
    font-size: 11px;
}

QComboBox, QDoubleSpinBox, QSpinBox {
    background-color: #3c3c3c;
    border: 1px solid #454545;
    color: #cccccc;
    padding: 4px 8px;
    border-radius: 3px;
}

QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #007fd4;
}

QGroupBox {
    border: 1px solid #333333;
    border-radius: 4px;
    margin-top: 8px;
    font-weight: bold;
    color: #e0e0e0;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
}